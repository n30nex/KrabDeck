{
  "schema_version": 2,
  "requirements": [
    {"id": "INT-BLE", "category": "interop", "description": "Official app matrix A-J over BLE", "hardware": true},
    {"id": "INT-USB", "category": "interop", "description": "Official meshcore.js matrix over companion USB", "hardware": true},
    {"id": "INT-GOLDEN", "category": "interop", "description": "Pinned stock companion golden-frame corpus passes", "hardware": false},
    {"id": "SOAK-IDLE", "category": "soak", "description": "At least 10 minutes idle with privacy-safe heap report", "hardware": true, "artifact_roles": ["debug", "production"]},
    {
      "id": "SOAK-ACTIVE",
      "category": "soak",
      "description": "At least two hours active use with authoritative privacy-safe stability thresholds",
      "hardware": true,
      "artifact_roles": ["debug", "production"],
      "required_claims": {
        "final_capture_valid": true,
        "no_crash_or_reboot": true,
        "no_monotonic_heap_loss": true,
        "no_monotonic_psram_loss": true,
        "regular_samples_present": true,
        "responsive_at_end": true
      },
      "metric_bounds": {
        "completion_percent": {"min": 90, "max": 100},
        "duration_seconds": {"min": 7200},
        "heap_range_bytes": {"min": 0, "max": 999},
        "sample_count": {"min": 120}
      }
    },
    {"id": "OTA-UPGRADE", "category": "ota", "description": "Successful authenticated OTA preserves state", "hardware": true, "artifact_roles": ["ota", "production"]},
    {"id": "OTA-NO-UPDATE", "category": "ota", "description": "No-new-release response leaves running image intact", "hardware": true, "artifact_roles": ["ota", "production"]},
    {"id": "OTA-AUTH-FAIL", "category": "ota", "description": "Missing or rejected credentials fail safely", "hardware": true, "artifact_roles": ["ota", "production"]},
    {"id": "OTA-DOWNLOAD-FAIL", "category": "ota", "description": "Network, TLS, or truncated download fails safely", "hardware": true, "artifact_roles": ["ota", "production"]},
    {"id": "OTA-IMAGE-FAIL", "category": "ota", "description": "Invalid image or write failure keeps a bootable image", "hardware": true, "artifact_roles": ["ota", "production"]},
    {"id": "OTA-SIGNATURE", "category": "ota", "description": "Device-side publisher-signature status is recorded without treating checksums as signatures", "hardware": false, "artifact_roles": ["ota", "production"]},
    {"id": "OTA-DOWNGRADE", "category": "ota", "description": "An image with an older security epoch is rejected before activation", "hardware": true, "artifact_roles": ["ota", "production"]},
    {"id": "OTA-TLS-ROTATION", "category": "ota", "description": "Maintained TLS roots, expiry failure, and offline recovery are exercised", "hardware": true, "artifact_roles": ["ota", "production"]},
    {"id": "BLE-BOND-REVOKE", "category": "interop", "description": "A revoked BLE bond cannot resume administration without pairing", "hardware": true},
    {"id": "RESET-RECONNECT", "category": "interop", "description": "Factory reset prevents old companion credentials from silently reconnecting", "hardware": true},
    {"id": "LAUNCH-DETECT", "category": "launcher", "description": "Launcher environment is detected", "hardware": true},
    {"id": "LAUNCH-HANDOFF", "category": "launcher", "description": "Exit/relaunch handoff returns to Launcher", "hardware": true},
    {"id": "LAUNCH-OTA-GATE", "category": "launcher", "description": "Self-OTA is unavailable under Launcher", "hardware": true},
    {"id": "LAUNCH-STATE", "category": "launcher", "description": "Settings and stores survive Launcher relaunch", "hardware": true},
    {"id": "REL-ARTIFACTS", "category": "release", "description": "Web flasher, merged, app, Launcher, recovery, and debug artifacts match manifests and hashes", "hardware": false, "artifact_roles": ["debug", "ota", "production", "recovery"]},
    {"id": "REL-WARNINGS", "category": "release", "description": "First-party warning delta gate passes", "hardware": false},
    {
      "id": "DEVICE-ISOLATION",
      "category": "device-isolation",
      "description": "Only the pinned T-Deck Plus target was accessed",
      "hardware": true,
      "artifact_roles": ["production", "recovery"],
      "peer_required": false,
      "required_claims": {"forbidden_serials_unopened": true, "protected_device_untouched": true},
      "metric_bounds": {"d1l_access_count": {"min": 0, "max": 0}, "peer_access_count": {"min": 0, "max": 0}}
    },
    {
      "id": "UI-MATRIX",
      "category": "ui-matrix",
      "description": "All production UI routes and physical input modes were reviewed",
      "hardware": true,
      "peer_required": false,
      "required_claims": {"captures_redaction_safe": true, "focus_accessibility_reviewed": true, "keyboard_verified": true, "route_matrix_complete": true, "touch_verified": true, "trackball_verified": true}
    },
    {
      "id": "RF-END-TO-END",
      "category": "rf-end-to-end",
      "description": "Independent observer verifies correlated delivery, ACK, retry, silence, and recovery RF behavior",
      "hardware": true,
      "evidence_classes": ["independent-observer"],
      "artifact_roles": ["production", "recovery"],
      "required_claims": {
        "boot_advert_observed": true,
        "channel_acked": true,
        "channel_delivered": true,
        "correlation_verified": true,
        "dm_acked": true,
        "dm_delivered": true,
        "forced_failure_injected": true,
        "observer_liveness_verified": true,
        "public_chat_silent": true,
        "recovery_rf_silent": true,
        "rf_profile_verified": true,
        "single_retry_verified": true
      },
      "metric_bounds": {
        "boot_advert_count": {"min": 1, "max": 1},
        "candidate_window_seconds": {"min": 900},
        "channel_acked_count": {"min": 1},
        "channel_delivered_count": {"min": 1},
        "dm_acked_count": {"min": 1},
        "dm_delivered_count": {"min": 1},
        "public_chat_count": {"min": 0, "max": 0},
        "recovery_packet_count": {"min": 0, "max": 0},
        "recovery_window_seconds": {"min": 60},
        "retry_count": {"min": 1, "max": 1}
      }
    },
    {
      "id": "STATE-MIGRATION",
      "category": "state-migration",
      "description": "Production migration and reboot preserve identity, settings, and stores",
      "hardware": true,
      "peer_required": false,
      "required_claims": {"identity_preserved": true, "settings_preserved": true, "stores_preserved": true}
    },
    {
      "id": "SD-MAP",
      "category": "sd-map",
      "description": "SD persistence and offline map behavior survive reboot without disrupting shared SPI radio use",
      "hardware": true,
      "peer_required": false,
      "required_claims": {"offline_tiles_wifi_disabled": true, "radio_preserved": true, "resume_after_reboot": true, "sentinel_preserved_or_justified": true, "shared_spi_preserved": true}
    },
    {
      "id": "WIFI-PRIVATE",
      "category": "wifi-private",
      "description": "Private Wi-Fi success and bounded error paths leave no public secret material",
      "hardware": true,
      "peer_required": false,
      "required_claims": {"bounded_error_path": true, "private_network_connected": true, "public_secret_scan_clean": true}
    },
    {
      "id": "GPS-SIM-LIVE",
      "category": "gps-sim-live",
      "description": "Simulated and live GPS fixes drive local time without publishing coordinates",
      "hardware": true,
      "peer_required": false,
      "required_claims": {"coordinates_not_published": true, "live_fix_verified": true, "local_time_verified": true, "simulated_fix_verified": true}
    },
    {
      "id": "OTA-FULL-EQUIVALENCE",
      "category": "ota-full-equivalence",
      "description": "OTA app image is statically and operationally equivalent to the production full image",
      "hardware": true,
      "artifact_roles": ["ota", "production"],
      "peer_required": false,
      "required_claims": {"runtime_equivalence_verified": true, "state_equivalence_verified": true, "static_app_equivalence_verified": true}
    }
  ]
}
