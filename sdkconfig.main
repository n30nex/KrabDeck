// sdkconfig.main — Override for 8MB flash T-Deck
// The board definition assumes 16MB flash + 8MB PSRAM (OPI),
// but this unit has 8MB flash and PSRAM ID reads return zeros.
//
// Format: C preprocessor #defines (matching sdkconfig.h)

// Disable PSRAM
#define CONFIG_SPIRAM 0
#define CONFIG_SPIRAM_BOOT_INIT 0
#define CONFIG_SPIRAM_IGNORE_NOTFOUND 1
#define CONFIG_SPIRAM_USE_CAPS_ALLOC 0
#define CONFIG_SPIRAM_USE_MALLOC 0
#define CONFIG_SPIRAM_MODE_OCT 0
#define CONFIG_SPIRAM_MODE_QUAD 0

// 8MB flash
#define CONFIG_ESPTOOLPY_FLASHSIZE_8MB 1
#define CONFIG_ESPTOOLPY_FLASHSIZE "8MB"
#define CONFIG_ESPTOOLPY_FLASHSIZE_DETECT 1
#define CONFIG_ESPTOOLPY_FLASHFREQ_80M 1
#define CONFIG_ESPTOOLPY_FLASHMODE_DIO 1

// Core dump to flash
#define CONFIG_ESP_COREDUMP_TO_FLASH 1
#define CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF 1
#define CONFIG_ESP_COREDUMP_MAX_TASKS_NUM 16
